# /var/www/record-staging/.env — staging (https://recordstaging.mtrokel.org, pm2 "record-staging", port 3002)
NODE_ENV=production
DATABASE_URL=postgresql://record:CHANGE_ME@localhost:5432/record_staging
NEXTAUTH_URL=https://recordstaging.mtrokel.org
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
# Google OAuth: the SAME client can be reused, but you must add
#   https://recordstaging.mtrokel.org/api/auth/callback/google
# as an authorised redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Workspace directory search (service account JSON + impersonated admin)
GOOGLE_DIRECTORY_SA_KEY=
GOOGLE_DIRECTORY_SUBJECT=
# AWS — ISOLATED staging resources created by deploy/aws-staging.sh (own bucket, KMS key, IAM user);
# paste the values that script prints.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=the-record-media-staging
KMS_KEY_ARN=   # alias/the-record-articles-staging, from deploy/aws-staging.sh
# Blind-index pepper (HMAC). Use a DIFFERENT value from prod; staging has its own DB.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
# Shared secret for POST /api/cron/publish-scheduled, the job that publishes scheduled issues.
# /etc/cron.d/record-publish greps it out of this file every minute. Use a DIFFERENT value from
# prod. Unset ⇒ the route 500s and nothing scheduled ever goes live. openssl rand -hex 32
CRON_SECRET=CHANGE_ME_openssl_rand_hex_32
