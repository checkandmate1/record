# /var/www/record/.env — production (https://record.mtrokel.org, pm2 "record", port 3001)
NODE_ENV=production
DATABASE_URL=postgresql://record:CHANGE_ME@localhost:5432/record
NEXTAUTH_URL=https://record.mtrokel.org
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
# Google OAuth: the SAME client can be reused, but you must add
#   https://recordstaging.mtrokel.org/api/auth/callback/google
# as an authorised redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Workspace directory search (service account JSON + impersonated admin)
GOOGLE_DIRECTORY_SA_KEY=
GOOGLE_DIRECTORY_SUBJECT=
# AWS — shared with prod (same IAM user, same KMS key, same bucket). Staging writes under
# uploads/staging/ only if the code is told to; see docs/aws-infrastructure.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=the-record-media
KMS_KEY_ARN=arn:aws:kms:us-east-1:561226079992:key/e4ab66f6-eea5-4543-a17c-38cc6b91e93c
# Blind-index pepper (HMAC). Rotating this invalidates every emailHash → breaks sign-in. Never change it casually.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
