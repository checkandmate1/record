generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  READER
  WRITER
  DESIGNER
  PHOTOGRAPHER
  ART_TEAM
  EDITOR
  CHIEF_EDITOR
  WEB_TEAM
  WEB_MASTER
}

enum Section {
  NEWS
  OPINIONS
  LIONS_DEN
  A_AND_E
  FEATURES
  THE_ROUNDTABLE
  MD_ALUMNI
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String    @id @default(uuid())
  // Legacy columns — wiped to NULL by phase5_wipe_legacy migration. Kept in schema as nullable
  // so call sites still typecheck; lib/prisma synthesizes plaintext from envelope on read and
  // strips plaintext from `data` on write so Prisma stores NULL here.
  email         String?   @unique
  name          String?
  image         String?
  googleImage   String?
  emailVerified DateTime?
  role          Role      @default(READER)
  displayTitle  String?
  priority      Int       @default(0)
  isAdmin       Boolean   @default(false)
  isPlaceholder Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // KMS envelope encryption — canonical source of truth.
  emailCiphertext Bytes
  emailHash       Bytes   @unique
  nameCiphertext  Bytes
  imageCiphertext Bytes?
  encryptedDek    Bytes
  dekKekVersion   Int

  articles            Article[]
  articleCredits      ArticleCredit[]
  accounts            Account[]
  sessions            Session[]
  approvals           Approval[]
  roundTableSides     RoundTableSideAuthor[]

  @@index([isPlaceholder])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Article {
  id            String        @id @default(uuid())
  title         String        @db.VarChar(300)
  slug          String        @unique
  // Legacy plaintext column — wiped; ciphertext is canonical.
  body          String?
  excerpt       String?       @db.VarChar(500)
  featuredImage String?
  section       Section
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String

  groupId     String

  // KMS envelope encryption — canonical.
  bodyCiphertext          Bytes
  featuredImageCiphertext Bytes?
  encryptedDek            Bytes
  dekKekVersion           Int

  createdBy  User           @relation(fields: [createdById], references: [id])
  group      ArticleGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  credits    ArticleCredit[]
  images     ArticleImage[]
  blockSlots BlockSlot[]
  approvals  Approval[]

  @@index([groupId])
  @@index([section])
  @@index([createdById])
}

model ArticleCredit {
  id         String  @id @default(uuid())
  articleId  String
  userId     String
  // Legacy plaintext column — wiped; ciphertext is canonical.
  creditRole String?

  // KMS envelope encryption — canonical. Uniqueness is on creditRoleHash now.
  creditRoleCiphertext Bytes
  creditRoleHash       Bytes
  encryptedDek         Bytes
  dekKekVersion        Int

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([articleId, userId, creditRoleHash])
  @@index([userId])
  // No separate @@index([articleId]) — it's the leading column of the unique constraint above,
  // so Postgres can already use that composite index for an equality lookup on articleId alone.
}

model ArticleImage {
  id        String  @id @default(uuid())
  articleId String
  // Legacy plaintext columns — wiped; ciphertext is canonical.
  url       String?
  caption   String?
  altText   String?
  order     Int

  // KMS envelope encryption — canonical.
  urlCiphertext     Bytes
  captionCiphertext Bytes?
  altTextCiphertext Bytes
  encryptedDek      Bytes
  dekKekVersion     Int

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model SiteSetting {
  key   String @id
  value String
}

model ArticleGroup {
  id           String    @id @default(uuid())
  name         String?   @db.VarChar(200)
  volumeNumber Int?
  issueNumber  Int?
  status       ArticleStatus @default(DRAFT)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Optional print-issue PDF, served via streaming proxy at /api/issues/[id]/pdf.
  // Stored in private S3 prefix issue-pdfs/<groupId>/<uuid>.pdf. Filename/size are
  // upload-time metadata for dashboard display; not encrypted (binary lives in S3).
  pdfKey        String?
  pdfFilename   String?
  pdfByteSize   Int?
  pdfUploadedAt DateTime?

  blocks      LayoutBlock[]
  articles    Article[]
  approvals   Approval[]
  roundTables RoundTable[]

  @@index([status])
}

// Append-only audit log of issue PDF fetches. No FKs so historical access survives
// user/group deletion. Indexed for "who read what" and "who has been reading PDFs"
// queries from the admin panel (out of scope for v1; just collected).
model IssuePdfAccess {
  id        String   @id @default(uuid())
  userId    String
  groupId   String
  fetchedAt DateTime @default(now())

  @@index([groupId, fetchedAt])
  @@index([userId, fetchedAt])
}

model RoundTable {
  id        String   @id @default(uuid())
  slug      String   @unique
  // Legacy plaintext column — wiped; ciphertext is canonical.
  prompt    String?  @db.VarChar(500)
  // No separate @@index([groupId]) here — @unique already creates one.
  groupId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // KMS envelope encryption — canonical.
  promptCiphertext Bytes
  encryptedDek     Bytes
  dekKekVersion    Int

  group ArticleGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sides RoundTableSide[]
  turns RoundTableTurn[]
}

model RoundTableSide {
  id           String  @id @default(uuid())
  roundTableId String
  // Legacy plaintext column — wiped; ciphertext is canonical.
  label        String? @db.VarChar(80)
  order        Int

  // KMS envelope encryption — canonical.
  labelCiphertext Bytes
  encryptedDek    Bytes
  dekKekVersion   Int

  roundTable RoundTable             @relation(fields: [roundTableId], references: [id], onDelete: Cascade)
  authors    RoundTableSideAuthor[]
  turns      RoundTableTurn[]

  @@index([roundTableId])
}

model RoundTableSideAuthor {
  id     String @id @default(uuid())
  sideId String
  userId String

  side RoundTableSide @relation(fields: [sideId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id])

  @@unique([sideId, userId])
}

model RoundTableTurn {
  id           String  @id @default(uuid())
  roundTableId String
  sideId       String
  // Legacy plaintext column — wiped; ciphertext is canonical.
  body         String?
  order        Int

  // KMS envelope encryption — canonical.
  bodyCiphertext Bytes
  encryptedDek   Bytes
  dekKekVersion  Int

  roundTable RoundTable     @relation(fields: [roundTableId], references: [id], onDelete: Cascade)
  side       RoundTableSide @relation(fields: [sideId], references: [id], onDelete: Cascade)

  @@index([sideId])
}

model LayoutBlock {
  id           String  @id @default(uuid())
  groupId      String
  column       String  // "main" | "sidebar"
  pattern      String  // pattern ID from registry
  order        Int
  dividerStyle String  @default("light") // "light" | "bold" | "none"

  group  ArticleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slots  BlockSlot[]

  @@index([groupId])
}

model BlockSlot {
  id          String  @id @default(uuid())
  blockId     String
  slotRole    String  // "article" | "headline" | "image" | "media"
  order       Int
  articleId   String?
  mediaUrl    String?
  mediaType   String?
  mediaAlt    String?
  mediaCredit String?
  scale       String  @default("M") // "S" | "M" | "L" | "XL"
  imageScale  String  @default("M") // "S" | "M" | "L" | "XL"
  previewLength Int     @default(200)
  featured      Boolean @default(false)
  showByline    Boolean @default(true)
  imageFloat    String  @default("full") // "left" | "right" | "full"
  imageWidth    Int     @default(100) // 10-100 percentage of container
  imageCrop     String  @default("original") // "original" | "landscape" | "portrait" | "square" | "custom"
  imageCropCustom String? // e.g. "16:9" for custom ratio

  block   LayoutBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  article Article?    @relation(fields: [articleId], references: [id])

  @@index([blockId])
  @@index([articleId])
}

model Approval {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  articleId String?
  groupId   String?

  user    User          @relation(fields: [userId], references: [id])
  article Article?      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  group   ArticleGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@unique([userId, groupId])
  @@index([articleId])
  @@index([groupId])
  // No separate @@index([userId]) — it's the leading column of both unique constraints above,
  // so Postgres can already use either composite index for an equality lookup on userId alone.
}
