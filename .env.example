# Database
DATABASE_URL=postgresql://user:password@localhost:5432/the_record

# NextAuth
# NEXTAUTH_URL is auto-detected on Vercel. Set manually for other environments.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=the-record-media

# Blind-index HMAC pepper (required in every environment; the name predates KMS envelope encryption).
# Generate with: openssl rand -hex 32. Rotating it breaks sign-in (emailHash) — never change casually.
ENCRYPTION_KEY=

# KMS envelope-encryption key (required — every write to an encrypted model fails without it)
KMS_KEY_ARN=arn:aws:kms:us-east-1:<account>:key/<key-id>

# Optional: fetch ENCRYPTION_KEY from AWS Secrets Manager instead (prod only; no secret exists today)
# AWS_SECRETS_MANAGER_KEY_ARN=

# Optional: Google Workspace directory search in the admin panel (service-account JSON + admin to impersonate)
# GOOGLE_DIRECTORY_SA_KEY=
# GOOGLE_DIRECTORY_SUBJECT=
